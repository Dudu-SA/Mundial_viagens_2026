rules_version = '2';

// Regras do banco do site da Mundial Viagens.
// - Qualquer visitante pode LER as viagens e os destaques (é o que o site mostra).
// - Só o administrador (o e-mail do painel) pode criar, editar ou apagar viagens e destaques.
// - O formulário de contato pode CRIAR mensagens; só o administrador pode lê-las.
// Para publicar: Firebase Console > Firestore Database > Regras (cole este arquivo)
// ou, no terminal, `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function admin() {
      return request.auth != null && request.auth.token.email == "admin@mundialviagens.com";
    }

    match /promocoes/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /destaques/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /contatos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'telefone', 'email', 'destino', 'mes', 'mensagem', 'criadoEm'])
                    && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 200
                    && request.resource.data.email is string && request.resource.data.email.size() <= 200
                    && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 5000;
      allow read, update, delete: if admin();
    }
  }
}
